  class?: string;
}
const { name, class: cls } = Astro.props;
const paths: Record<Props['name'], string> = {
  arrow: 'M3 12h17m-6-6 6 6-6 6',
  'arrow-up-right': 'M5 19 19 5M5 5h14v14',
  check: 'm5 12 4 4L19 6',
  phone: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2',
  mail: 'M3 6h18v12H3zM3 7l9 6 9-6',
  close: 'M6 6l12 12M18 6 6 18',
  prev: 'M21 12H4m6-6-6 6 6 6',
  next: 'M3 12h17m-6-6 6 6-6 6',
  message: 'M4 5h16v11H9l-5 4z',
  shield: 'M12 3 4.5 6v6c0 4.5 3.2 7.6 7.5 9 4.3-1.4 7.5-4.5 7.5-9V6zM8.5 12l2.5 2.5 4.5-4.5',
  home: 'M3.5 11 12 4l8.5 7M6 9.5V20h12V9.5M10 20v-5h4v5',
  pencil: 'M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4',
  swap: 'M8 7 3 12l5 5M16 7l5 5-5 5',
