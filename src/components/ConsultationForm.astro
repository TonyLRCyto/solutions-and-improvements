---
/**
 * The one shared consultation form (home + /contact). Works as a normal HTML form without JavaScript;
 * src/scripts/consultation-form.ts adds inline validation and honest status messages.
 */
import Icon from './Icon.astro';
import { formServices } from '../data/form-options';
import { propertyTypes, contactPrefs, LIMITS } from '../lib/consultation';
import { company, cta, turnstileSiteKey, IS_PREVIEW } from '../data/site';

interface Props {
  idPrefix?: string;
  service?: string;
  topic?: string;
  topicLabel?: string;
  /** slug -> name map so /contact can show which page the visitor came from. */
  topics?: Record<string, string>;
}
const { idPrefix = 'cf', service = '', topic = '', topicLabel = '', topics } = Astro.props;
const id = (s: string) => `${idPrefix}-${s}`;
---
<div class="form-card">
  <form
    class="consult-form"
    action="/api/consultation"
    method="post"
    novalidate
    data-consult-form
    data-preselect={service}
    data-topics={topics ? JSON.stringify(topics) : undefined}
    aria-describedby={id('intro')}
  >
    <p class="form-context" id={id('intro')}>
      Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.
      We need an email <em>or</em> a phone number.
    </p>
    <p class="form-context" data-topic-note hidden={!topicLabel}>About: <strong>{topicLabel}</strong></p>

    <div class="form-summary" role="alert" tabindex="-1" hidden data-summary>
      <h3>Please check the following</h3>
      <ul></ul>
    </div>

    <div class="form-grid">
      <div class="field field--full">
        <label for={id('name')}>Name <span aria-hidden="true">*</span></label>
        <input id={id('name')} name="name" type="text" autocomplete="name" required maxlength={LIMITS.name} aria-describedby={id('name-err')} />
        <p class="error" id={id('name-err')} data-error-for="name"></p>
      </div>

      <div class="field">
        <label for={id('email')}>Email</label>
        <input id={id('email')} name="email" type="email" autocomplete="email" inputmode="email" maxlength={LIMITS.email} aria-describedby={id('contact-hint') + ' ' + id('email-err')} />
        <p class="error" id={id('email-err')} data-error-for="email"></p>
      </div>
      <div class="field">
        <label for={id('phone')}>Phone</label>
        <input id={id('phone')} name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength={LIMITS.phone} aria-describedby={id('contact-hint') + ' ' + id('phone-err')} />
        <p class="error" id={id('phone-err')} data-error-for="phone"></p>
      </div>
      <p class="field--full hint" id={id('contact-hint')} style="margin-top:-.5rem;font-size:.85rem;color:var(--text-muted)">
        Email or phone is required. <span class="error" data-error-for="contact" id={id('contact-err')}></span>
      </p>

      <div class="field">
        <label for={id('location')}>Project city or ZIP <span aria-hidden="true">*</span></label>
        <input id={id('location')} name="location" type="text" autocomplete="address-level2" required maxlength={LIMITS.location} aria-describedby={id('location-err')} />
        <p class="error" id={id('location-err')} data-error-for="location"></p>
      </div>
      <div class="field">
        <label for={id('service')}>Project type <span aria-hidden="true">*</span></label>
        <select id={id('service')} name="service" required aria-describedby={id('service-err')}>
          <option value="" selected={!service}>Choose one</option>
          {formServices.map((s) => <option value={s.value} selected={s.value === service}>{s.label}</option>)}
        </select>
        <p class="error" id={id('service-err')} data-error-for="service"></p>
      </div>

      <div class="field field--full">
        <label for={id('property')}>Property type <span class="opt">(optional)</span></label>
        <select id={id('property')} name="property">
          <option value="">Choose one</option>
          {propertyTypes.map((p) => <option value={p.value}>{p.label}</option>)}
        </select>
      </div>

      <div class="field field--full">
        <label for={id('description')}>About the project <span aria-hidden="true">*</span></label>
        <textarea id={id('description')} name="description" required minlength={LIMITS.description.min} maxlength={LIMITS.description.max} rows="5" aria-describedby={id('description-hint') + ' ' + id('description-err')}></textarea>
        <p class="hint" id={id('description-hint')}>A few sentences is plenty: what you want to change, and anything we should know.</p>
        <p class="error" id={id('description-err')} data-error-for="description"></p>
      </div>

      <fieldset class="field field--full">
        <legend>Best way to reach you <span class="opt">(optional)</span></legend>
        <div class="radio-row">
          {contactPrefs.map((p) => (
            <label><input type="radio" name="contactPref" value={p.value} /> {p.label}</label>
          ))}
        </div>
      </fieldset>
    </div>

    <div class="hp-field" aria-hidden="true">
      <label for={id('website')}>Leave this field empty</label>
      <input id={id('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="topic" value={topic} />
    <input type="hidden" name="startedAt" value="" data-started />
    <input type="hidden" name="idempotencyKey" value="" data-idem />

    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="consultation" data-size="flexible"></div>}

    <div class="form-foot">
      <div class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-status></div>
      <button class="btn btn--primary btn--lg" type="submit" data-submit>
        <span data-label>{cta.label}</span><Icon name="arrow" />
      </button>
      <p class="form-privacy">
        Submitting doesn’t book an appointment. We’ll follow up by phone or message. We use your details only to respond to this request; see our <a href="/privacy">privacy note</a>.
        Prefer to talk? Call <a href={company.phoneHref} data-track="phone_click">{company.phoneDisplay}</a>.
      </p>
      {IS_PREVIEW && (
        <p class="preview-flag">Preview build: online delivery is not connected yet. Submitting will show an honest “not sent” message.</p>
      )}
    </div>
  </form>
</div>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  import '../scripts/consultation-form.ts';
</script>
