---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, cta, company } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/'));
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <Logo height={72} alt="Solutions and Improvements home" />
    </a>
    <nav class="primary-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--primary header-cta" href={cta.href} data-track="cta_consultation">
        {cta.label}<Icon name="arrow" />
      </a>
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" hidden>
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" hidden>
  <nav aria-label="Main mobile">
    <ul>
      {nav.map((item) => (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}<Icon name="arrow" class="i" /></a></li>
      ))}
    </ul>
  </nav>
  <a class="btn btn--primary btn--lg" href={cta.href} data-track="cta_consultation">{cta.label}<Icon name="arrow" /></a>
  <div class="contact-lines">
    <a href={company.phoneHref} data-track="phone_click">{company.phoneDisplay}</a>
    <a href={`mailto:${company.email}`} data-track="email_click">{company.email}</a>
  </div>
</div>
