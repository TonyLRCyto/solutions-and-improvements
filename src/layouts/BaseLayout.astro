---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { IS_PREVIEW, company, cta } from '../data/site';
import { absolute, businessSchema } from '../lib/seo';

interface Props {
  /** Page-specific title. The company name is appended unless `fullTitle` is set. */
  title: string;
  fullTitle?: boolean;
  description: string;
  /** Canonical path, e.g. "/kitchen-remodeling". Defaults to the current path. */
  path?: string;
  /** Force noindex (drafts). Preview builds are always noindex. */
  noindex?: boolean;
  ogImage?: string;
  schema?: object[];
  /** Shown only in preview builds, for draft/review pages. */
  draftNote?: string;
}

const {
  title,
  fullTitle = false,
  description,
  path = Astro.url.pathname.replace(/\/$/, '') || '/',
  noindex = false,
  ogImage = '/og-image.jpg',
  schema = [],
  draftNote,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${company.name}`;
const canonical = absolute(path);
const robots = IS_PREVIEW || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const jsonLd = [businessSchema(), ...schema];
---
<!doctype html>
<html lang="en-US" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {IS_PREVIEW && draftNote && (
      <div class="draft-note" role="note"><div class="container"><strong>Preview draft:</strong> {draftNote}</div></div>
    )}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <nav class="callbar" aria-label="Quick contact">
      <a class="callbar__call" href={company.phoneHref} data-track="phone_click"><Icon name="phone" />Call</a>
      <a class="callbar__text" href={company.smsHref} data-track="sms_click"><Icon name="message" />Text</a>
      <a class="callbar__consult" href={cta.href} data-track="cta_consultation">{cta.label}</a>
    </nav>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
