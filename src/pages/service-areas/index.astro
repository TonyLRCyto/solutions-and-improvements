---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import ConsultCallout from '../../components/ConsultCallout.astro';
import { regions, cities } from '../../data/areas';
import { IS_PREVIEW } from '../../data/site';
import { breadcrumbSchema } from '../../lib/seo';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Service Areas' }];
const visibleCities = cities.filter((c) => c.indexReady || IS_PREVIEW);
---
<BaseLayout
  title="Service Areas: Northwest Indiana & South Chicagoland"
  description="Solutions and Improvements works across Lake and Porter counties, Portage, La Porte and South Bend, Indiana, and south Chicago-area communities from Lansing to Mokena, Illinois."
  path="/service-areas"
  schema={[breadcrumbSchema(crumbs.map((c) => ({ label: c.label, href: c.href ?? '/service-areas' })))]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>Service areas</h1>
      <p class="lede">Based in Munster since 1990, we work across Northwest Indiana, east through South Bend, and west across the state line to Mokena, Illinois.</p>
    </div>
  </section>

  <section class="section section--white section--tight areas-section" aria-label="Regions and communities">
    <div class="container">
      {IS_PREVIEW && visibleCities.length > 0 && <p class="preview-flag" style="margin-bottom:1.5rem">Preview: the {visibleCities.length} community pages are being reviewed before launch.</p>}
      <div class="areas-grid">
        {regions.map((r) => {
          const regionCities = visibleCities.filter((c) => c.region === r.slug);
          // Filter towns individually so a ready city does not hide its unready neighbor.
          const otherAreas = r.coverage
            .flatMap((item) => item.split(' & '))
            .filter((item) => !regionCities.some((c) => item.includes(c.name)));
          return (
            <article class:list={['area-card', 'area-card--merged', { 'area-card--il': r.slug === 'illinois' }]}>
              <h2 class="h-lg">{r.name}</h2>
              <p class="muted">{r.intro}</p>
              {regionCities.length > 0 && (
                <>
                  <h3 class="area-card__sub">Communities</h3>
                  <ul class="city-buttons">
                    {regionCities.map((c) => <li><a href={c.path}>{c.name}, {c.state}<Icon name="arrow" /></a></li>)}
                  </ul>
                </>
              )}
              {otherAreas.length > 0 && (
                <p class="area-card__coverage"><b>{regionCities.length > 0 ? 'Also serving:' : 'Communities we serve:'}</b> {otherAreas.join(', ')}.</p>
              )}
              <a class="btn btn--outline" href={r.path}>Working in {r.short}<Icon name="arrow" /></a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <ConsultCallout text="Not sure if you’re in our area? Ask. We cover the broader region, not just the towns listed here." />
</BaseLayout>
