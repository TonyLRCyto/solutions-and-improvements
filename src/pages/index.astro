---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import BlueprintLines from '../components/BlueprintLines.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import { photos } from '../data/photos';
import { featuredServices, commercialService } from '../data/services';
import { regions, cities } from '../data/areas';
import { company, cta, financing, IS_PREVIEW } from '../data/site';

const visibleCities = cities.filter((c) => c.indexReady || IS_PREVIEW);
---
<BaseLayout
  title="Solutions and Improvements | Construction & Remodeling in Northwest Indiana & South Chicagoland"
  fullTitle
  description="Construction and remodeling since 1990: bathrooms, kitchens, additions and new construction for homes, commercial and multifamily properties across Northwest Indiana and South Chicagoland."
  path="/"
  settle
>
  <!-- 1. Opening -->
  <section class="hero blueprint on-dark" aria-labelledby="hero-h">
    <BlueprintLines />
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-h" class="display">Construction and remodeling since 1990.</h1>
          <p class="hero-intro">For homes and businesses across Northwest Indiana and South Chicagoland.</p>
          <div class="hero-actions">
            <a class="btn btn--primary btn--lg" href={cta.href} data-track="cta_consultation">{cta.label}</a>
            <a class="btn btn--outline btn--lg" href="/projects">View our work</a>
          </div>
        </div>
        <div class="hero-media">
          <figure style="margin:0">
            <div class="plane" data-settle>
              <div class="plane-frame">
                <Photo
                  photo={photos.A}
                  priority
                  widths={[360, 480, 600, 760, 960, 1200, 1600, 2000]}
                  sizes="(max-width: 832px) 92vw, (max-width: 1460px) 42vw, 580px"
                />
              </div>
            </div>
            <figcaption class="hero-caption">{photos.A.caption}</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Services -->
  <section class="section section--paper home-services" aria-labelledby="svc-h">
    <div class="container">
      <div class="section-head">
        <h2 id="svc-h" class="h-xl">Our services</h2>
      </div>
      <ul class="svc-list svc-list--compact">
        {featuredServices.map((s) => (
          <li>
            <a href={s.path}>
              <span class="name">{s.name}</span>
              <Icon name="arrow-up-right" />
            </a>
          </li>
        ))}
      </ul>
      <div class="svc-more">
        <p class="muted">Projects of all sizes welcome, including small repairs.</p>
        <div class="svc-more-links">
          <a href={commercialService.path}>{commercialService.name}</a>
          <a href="/services">All services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Selected project views -->
  <section class="section section--white" aria-labelledby="work-h">
    <div class="container">
      <div class="section-head section-head--split">
        <span class="kicker">02 / Selected work</span>
        <h2 id="work-h" class="h-xl">The work is the evidence.</h2>
        <div class="stack">
          <p class="muted">A few views from recent work, from finished rooms to framing.</p>
          <a class="link-arrow" href="/projects">See all projects<Icon name="arrow" /></a>
        </div>
      </div>
      <div class="work-grid">
        <figure class="work-item work-item--a">
          <a href="/projects#kitchens"><div class="ph"><Photo photo={photos.K2} sizes="(max-width: 704px) calc(100vw - 2.5rem), 56vw" /></div>
          <figcaption><small>Kitchens</small>{photos.K2.caption}</figcaption></a>
        </figure>
        <figure class="work-item work-item--b">
          <a href="/projects#bathrooms"><div class="ph"><Photo photo={photos.B1} sizes="(max-width: 704px) 46vw, 38vw" widths={[300, 400, 540, 720, 960]} /></div>
          <figcaption><small>Bathrooms</small>{photos.B1.caption}</figcaption></a>
        </figure>
        <figure class="work-item work-item--c">
          <a href="/projects#kitchens"><div class="ph"><Photo photo={photos.K1} sizes="(max-width: 704px) 46vw, 38vw" widths={[300, 400, 540, 720, 960]} /></div>
          <figcaption><small>Kitchens</small>{photos.K1.caption}</figcaption></a>
        </figure>
        <figure class="work-item work-item--d">
          <a href="/projects#in-progress"><div class="ph"><Photo photo={photos.C} sizes="(max-width: 704px) calc(100vw - 2.5rem), 56vw" /></div>
          <figcaption><small>In progress</small>{photos.C.caption}</figcaption></a>
        </figure>
      </div>
    </div>
  </section>

  <!-- 4. How projects begin -->
  <section class="blueprint on-dark process-panel" aria-labelledby="process-h" style="padding-block:var(--section)">
    <BlueprintLines variant="process" />
    <div class="container">
      <div class="section-head section-head--split">
        <span class="kicker">03 / How projects begin</span>
        <h2 id="process-h" class="h-xl">Start with a visit, not a guess.</h2>
        <p class="muted">The free consultation includes an on-site visit, so the scope is based on your actual space.</p>
      </div>
      <ProcessSteps
        steps={[
          { title: 'Consultation & site visit', text: 'Tell us about the project, then we visit to see the space and talk it through.' },
          { title: 'Scope & proposal', text: 'We define the work. Whether a detailed estimate is free or paid depends on the project, and we tell you up front.' },
          { title: 'Planning & construction', text: 'In-house design and renders where needed, then scheduling and building.' },
        ]}
      />
      <p class="process-note muted">Design work can begin after a rendering deposit or a signed construction contract. Ask us about financing through {financing.provider}.</p>
    </div>
  </section>

  <!-- 5. Service areas -->
  <section class="section section--paper" aria-labelledby="areas-h">
    <div class="container">
      <div class="section-head section-head--split">
        <span class="kicker">04 / Service areas</span>
        <h2 id="areas-h" class="h-xl">Both sides of the state line.</h2>
        <p class="muted">Founded in 1990 and based in Munster, working across Northwest Indiana and the south Chicago suburbs.</p>
      </div>
      <div class="areas-grid">
        {regions.map((r) => (
          <article class:list={['area-card', { 'area-card--il': r.slug === 'illinois' }]}>
            <span class="kicker">{r.short}</span>
            <h3>{r.name}</h3>
            <ul>{r.coverage.map((c) => <li>{c}</li>)}</ul>
            <a class="link-arrow" href={r.path}>{r.short} service area<Icon name="arrow" /></a>
          </article>
        ))}
      </div>
      {visibleCities.length > 0 && (
        <p class="city-links">
          <span class="muted">Communities:</span>
          {visibleCities.map((c) => <a href={c.path}>{c.name}, {c.state}</a>)}
          <a href="/service-areas">All service areas</a>
        </p>
      )}
    </div>
  </section>

  <!-- 6. Consultation -->
  <section class="section section--white" id="consultation" aria-labelledby="consult-h">
    <div class="container consult">
      <div class="consult-aside">
        <span class="kicker">05 / Free consultation</span>
        <h2 id="consult-h" class="h-xl">Tell us what you’re planning.</h2>
        <p class="lede muted">The consultation is free and includes an on-site visit. We’ll follow up by phone or message to arrange it.</p>
        <ul class="checks">
          <li>No minimum project size</li>
          <li>Homes, commercial and multifamily</li>
          <li>Design and renders in-house</li>
        </ul>
        <div class="contact-alt">
          <span class="kicker">Prefer to call?</span>
          <a href={company.phoneHref} data-track="phone_click">{company.phoneDisplay}</a>
          <a href={`mailto:${company.email}`} data-track="email_click" style="font-size:1rem">{company.email}</a>
        </div>
      </div>
      <ConsultationForm idPrefix="home" />
    </div>
  </section>
</BaseLayout>
