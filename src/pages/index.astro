---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Stars from '../components/Stars.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ContactWays from '../components/ContactWays.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import { photos } from '../data/photos';
import { featuredServices, serviceGroups, commercialService } from '../data/services';
import { reviews, reviewSummary } from '../data/reviews';
import { company, cta } from '../data/site';

const homeReviews = ['amanda', 'robert', 'luke'].map((id) => reviews.find((r) => r.id === id)!);
const cardPhoto = { 'new-construction': photos.EC, additions: photos.ADD, kitchens: photos.KQ, bathrooms: photos.BS } as const;
const order = ['new-construction', 'additions', 'kitchens', 'bathrooms'];
const mainServices = order.map((slug) => featuredServices.find((s) => s.slug === slug)!);
const strip = [photos.ADD, photos.KI, photos.BS, photos.K1, photos.BAR];
---
<BaseLayout
  title="Solutions and Improvements | Construction & Remodeling in Northwest Indiana & South Chicagoland"
  fullTitle
  description="Family-owned, licensed and insured contractor since 1990: new homes, additions, kitchens and bathrooms across Northwest Indiana and South Chicagoland. Free on-site consultation."
  path="/"
>
  <!-- Opening: project photo with the headline; on desktop the request form sits beside it -->
  <section class="photo-hero" aria-labelledby="hero-h">
    <div class="container photo-hero__grid">
      <div class="photo-hero__text">
        <div class="photo-hero__bg" aria-hidden="true">
          <Photo photo={photos.EC} alt="" priority sizes="(max-width: 992px) 100vw, 62vw" widths={[640, 800, 1024]} />
        </div>
        <p class="kicker">Northwest Indiana &amp; South Chicagoland · Licensed and insured</p>
        <h1 id="hero-h">Family-owned construction and remodeling since {company.founded}</h1>
        <p class="photo-hero__lede">New homes, additions, kitchens and bathrooms, with a free on-site consultation.</p>
        <div class="actions photo-hero__actions-desktop">
          <a class="btn btn--ghost-light btn--lg" href={company.phoneHref} data-track="phone_click"><Icon name="phone" />Call or text {company.phoneDisplay}</a>
        </div>
      </div>
      <div id="consultation" class="photo-hero__form">
        <ConsultationForm idPrefix="home" heading={cta.longLabel} />
      </div>
    </div>
  </section>

  <!-- Proof: before/after and Google reviews -->
  <section class="section section--white proof" aria-labelledby="proof-h">
    <div class="container">
      <div class="proof__grid">
        <BeforeAfter
          before={photos.GB}
          after={photos.GA}
          label="Compare the Munster garage before and after the rebuild"
          caption="Garage rebuilt after a fire · Munster, IN"
        />
        <div>
          <h2 id="proof-h" class="h-xl">What our clients say</h2>
          <div class="proof__score">
            <p class="reviews__score">{reviewSummary.rating}</p>
            <div>
              <Stars rating={reviewSummary.rating} size="lg" />
              <p>from {reviewSummary.count} reviews on Google</p>
            </div>
          </div>
          <ul class="proof__facts">
            <li><Icon name="shield" />Licensed and insured</li>
            <li><Icon name="home" />Family-owned since {company.founded}</li>
            <li><Icon name="check" />Free on-site consultation</li>
          </ul>
          {reviewSummary.url && <a class="btn btn--outline mt-1" href={reviewSummary.url} rel="noopener">Read all reviews</a>}
        </div>
      </div>
      <ul class="reviews__list swipe" aria-label="Client reviews" tabindex="0">
        {homeReviews.map((r) => <li><ReviewCard review={r} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Recent projects: photos only -->
  <section class="section section--white" aria-labelledby="work-h">
    <div class="container">
      <div class="section-head section-head--row">
        <h2 id="work-h" class="h-xl">Recent projects</h2>
        <a class="link-arrow" href="/projects">View all projects<Icon name="arrow" /></a>
      </div>
      <ul class="photo-strip" aria-label="Project photos" tabindex="0">
        {strip.map((p) => (
          <li><Photo photo={p} sizes="(max-width: 760px) 82vw, (max-width: 1320px) 48vw, 640px" widths={[400, 600, 800, 1000]} /></li>
        ))}
      </ul>
      <p class="swipe-hint">Swipe for more photos</p>
    </div>
  </section>

  <!-- Services -->
  <section class="section section--paper" aria-labelledby="svc-h">
    <div class="container">
      <div class="section-head">
        <h2 id="svc-h" class="h-xl">Services</h2>
        <p class="muted">Our four main services, plus repairs and specialty trades for homes and commercial properties.</p>
      </div>
      <ul class="svc-cards">
        {mainServices.map((s) => (
          <li>
            <a href={s.path}>
              <div class="ph"><Photo photo={cardPhoto[s.slug as keyof typeof cardPhoto]} alt="" sizes="(max-width: 560px) calc(100vw - 2.5rem), (max-width: 1000px) 46vw, 23vw" widths={[360, 480, 640, 800]} /></div>
              <div class="svc-cards__body">
                <h3>{s.name}</h3>
                <p>{s.summary}</p>
                <span class="svc-cards__go">Learn more<span class="visually-hidden"> about {s.name.toLowerCase()}</span><Icon name="arrow" /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <div class="other-services">
        <h3 class="h-md">Other services</h3>
        <ul class="other-services__list">
          {serviceGroups.map((g) => (
            <li><a href={g.path}><span><b>{g.title}</b><span>{g.text}</span></span><Icon name="arrow" /></a></li>
          ))}
          <li><a href={commercialService.path}><span><b>{commercialService.name}</b><span>{commercialService.summary}</span></span><Icon name="arrow" /></a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Company and process -->
  <section class="section section--paper company" aria-labelledby="family-h">
    <div class="container company__grid">
      <div>
        <h2 id="family-h" class="h-xl">A family business since {company.founded}</h2>
        <p class="muted family__text">Solutions and Improvements is owned by Gabriel Lopez, with Andy Lopez managing projects day to day. You work directly with them from the first visit to the final walkthrough.</p>
        <ul class="people">
          {company.team.map((t) => <li><span class="n">{t.name}</span><span class="r">{t.role}</span></li>)}
        </ul>
        <a class="link-arrow" href="/about-us">About the company<Icon name="arrow" /></a>
      </div>
      <div>
        <h3 class="h-md">How a project works</h3>
        <ProcessSteps
          headingLevel="h4"
          steps={[
            { title: 'Consultation and site visit', text: 'We visit, look at the space and discuss what you have in mind.' },
            { title: 'Scope, design and proposal', text: 'We define the scope and proposal. Design begins after a rendering deposit or signed contract.' },
            { title: 'Construction and walkthrough', text: 'We schedule the trades, manage the work and review the finished job with you.' },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- Contact. On phones the request form lives here; on desktop it is in the opening. -->
  <section class="contact-band contact-band--simple on-dark" id="request" aria-labelledby="consult-h">
    <div class="container contact-band__grid">
      <div>
        <h2 id="consult-h" class="h-xl">Talk to us about your project</h2>
        <p class="muted contact-band__intro">Call or text for the quickest answer, or send a request and we will follow up to schedule a visit.</p>
        <a class="btn btn--light btn--lg mt-2 desktop-only" href="#consultation" data-track="cta_consultation">{cta.longLabel}</a>
      </div>
      <div class="desktop-only"><ContactWays /></div>
      <div class="mobile-only">
        <ConsultationForm idPrefix="home-m" heading={cta.longLabel} />
        <p class="contact-band__email">Prefer email? <a href={`mailto:${company.email}`} data-track="email_click">{company.email}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
