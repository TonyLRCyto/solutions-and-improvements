---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import ConsultCallout from '../components/ConsultCallout.astro';
import { featuredServices, commercialService, serviceGroups, servicesInGroup, serviceHref } from '../data/services';
import { photos } from '../data/photos';
import { breadcrumbSchema } from '../lib/seo';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Services' }];
const cardPhoto = { 'new-construction': photos.EC, additions: photos.ADD, kitchens: photos.KQ, bathrooms: photos.BS } as const;
const order = ['new-construction', 'additions', 'kitchens', 'bathrooms'];
const mainServices = order.map((slug) => featuredServices.find((s) => s.slug === slug)!);
---
<BaseLayout
  title="Construction & Remodeling Services"
  description="New homes, additions, kitchens and bathrooms, plus commercial and multifamily work, exteriors, structure, repairs and restoration across Northwest Indiana and South Chicagoland."
  path="/services"
  schema={[breadcrumbSchema(crumbs.map((c) => ({ label: c.label, href: c.href ?? '/services' })))]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="kicker">Services</span>
      <h1>What we build and repair</h1>
      <p class="lede">Four specialties, every trade behind them, and no minimum project size.</p>
    </div>
  </section>

  <section class="section section--white section--tight" aria-labelledby="featured-h">
    <div class="container">
      <h2 id="featured-h" class="h-lg">Our specialties</h2>
      <ul class="svc-cards">
        {mainServices.map((s) => (
          <li>
            <a href={s.path}>
              <div class="ph"><Photo photo={cardPhoto[s.slug as keyof typeof cardPhoto]} alt="" sizes="(max-width: 560px) calc(100vw - 2.5rem), (max-width: 1000px) 46vw, 23vw" widths={[360, 480, 640, 800]} /></div>
              <div class="svc-cards__body">
                <h3>{s.name}</h3>
                <p>{s.summary}</p>
                <span class="svc-cards__go">{s.name}<Icon name="arrow" /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="panel-ink on-dark" aria-labelledby="commercial-h">
    <div class="container callout">
      <div>
        <h2 id="commercial-h" class="h-lg">{commercialService.name}</h2>
        <p class="muted mt-1" style="max-width:52ch">{commercialService.intro}</p>
      </div>
      <a class="btn btn--light btn--lg" href={commercialService.path}>Commercial &amp; multifamily<Icon name="arrow" /></a>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="more-h">
    <div class="container">
      <div class="section-head">
        <h2 id="more-h" class="h-xl">Every other trade, too.</h2>
        <p class="muted">Small repairs welcome. If you don’t see it here, ask.</p>
      </div>
      <div class="group-grid group-grid--3">
        {serviceGroups.map((g) => (
          <div class="group" id={g.id}>
            <h3><a href={g.path}>{g.title}</a></h3>
            <p>{g.text}</p>
            <ul>
              {servicesInGroup(g.id).map((s) => (
                <li><a href={serviceHref(s)}>{s.name}<Icon name="arrow" /></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ConsultCallout />
</BaseLayout>
