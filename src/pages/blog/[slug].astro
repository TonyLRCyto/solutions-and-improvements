---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ConsultCallout from '../../components/ConsultCallout.astro';
import { posts, type Post } from '../../data/posts';
import { breadcrumbSchema } from '../../lib/seo';

// The legacy article route is always generated so the address keeps working; drafts stay noindex.
export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const path = `/blog/${post.slug}`;
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Resources', href: '/blog' }, { label: post.title }];
---
<BaseLayout
  title={post.title}
  description={post.description}
  path={path}
  noindex={post.status !== 'published'}
  draftNote={post.status === 'draft' ? post.reviewNote : undefined}
  schema={[breadcrumbSchema(crumbs.map((c) => ({ label: c.label, href: c.href ?? path })))]}
>
  <article>
    <header class="page-hero">
      <div class="container">
        <Breadcrumbs items={crumbs} />
        <span class="kicker">Resources</span>
        <h1>{post.title}</h1>
        <p class="lede">{post.description}</p>
      </div>
    </header>
    <div class="section section--white section--tight">
      <div class="container prose" set:html={post.body} />
    </div>
  </article>
  <ConsultCallout />
</BaseLayout>
