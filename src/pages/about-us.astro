---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import ConsultCallout from '../components/ConsultCallout.astro';
import { company } from '../data/site';
import { photos } from '../data/photos';
import { breadcrumbSchema } from '../lib/seo';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'About' }];
---
<BaseLayout
  title="About Us"
  description="Solutions and Improvements has been a construction and remodeling company since 1990, based in Munster, Indiana. Meet Gabriel, Owner, and Andy, Project Manager."
  path="/about-us"
  schema={[breadcrumbSchema(crumbs.map((c) => ({ label: c.label, href: c.href ?? '/about-us' })))]}
>
  <section class="page-hero page-hero--split">
    <div class="container">
      <div>
        <Breadcrumbs items={crumbs} />
        <span class="kicker">About</span>
        <h1>Building and remodeling since 1990.</h1>
        <p class="lede">A Munster-based construction company working on homes, businesses and multifamily properties across Northwest Indiana and South Chicagoland.</p>
      </div>
      <p class="big-year" aria-hidden="true">1990</p>
    </div>
  </section>

  <section class="section section--white section--tight" aria-labelledby="approach-h">
    <div class="container">
      <div class="section-head">
        <span class="kicker">How we work</span>
        <h2 id="approach-h" class="h-lg">Four things we hold ourselves to.</h2>
      </div>
      <ul class="approach">
        {company.approach.map((a) => (
          <li><h3>{a.title}</h3><p>{a.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--paper section--tight" aria-labelledby="team-h">
    <div class="container svc-body">
      <div>
        <span class="kicker">Team</span>
        <h2 id="team-h" class="h-lg mt-1">Who you’ll talk to</h2>
      </div>
      <ul class="team">
        {company.team.map((t) => (
          <li><span class="n">{t.name}</span><span class="r">{t.role}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white section--tight" aria-label="Work in progress">
    <div class="container">
      <figure class="photo-figure">
        <div class="ph"><Photo photo={photos.Cwide} sizes="(max-width: 1460px) calc(100vw - 9rem), 1320px" widths={[640, 960, 1280, 1600, 2000]} /></div>
        <figcaption>{photos.Cwide.caption}</figcaption>
      </figure>
    </div>
  </section>

  <ConsultCallout />
</BaseLayout>
