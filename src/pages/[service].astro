---
/**
 * One template for every service page on its retained legacy path (e.g. /kitchen-remodeling),
 * plus the five group hubs (e.g. /interior-remodeling) that hold the smaller trades as sections.
 * Content comes from src/data/services.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import ArchGraphic from '../components/ArchGraphic.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ConsultCallout from '../components/ConsultCallout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ServiceHub from '../components/ServiceHub.astro';
import { pageServices, serviceBySlug, serviceGroups, serviceHref, type Service, type ServiceGroup } from '../data/services';
import { photos } from '../data/photos';
import { reviewFor } from '../data/reviews';
import { cta, company, financing } from '../data/site';
import { breadcrumbSchema, serviceSchema } from '../lib/seo';

export function getStaticPaths() {
  return [
    ...pageServices.map((service) => ({ params: { service: service.path.slice(1) }, props: { service } })),
    ...serviceGroups.map((group) => ({ params: { service: group.path.slice(1) }, props: { group } })),
  ];
}

const { service, group: hub } = Astro.props as { service?: Service; group?: ServiceGroup };

let crumbs: { label: string; href?: string }[] = [];
if (hub) crumbs = [{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: hub.title }];
else if (service) crumbs = [{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: service.name }];

const heroPhoto = service?.photos?.[0] ? photos[service.photos[0]] : undefined;
const supportPhoto = service?.photos?.[1] ? photos[service.photos[1]] : undefined;
const related = (service?.related ?? []).map(serviceBySlug).filter(Boolean) as Service[];
const consultHref = service ? `${cta.href}?service=${service.formService}&topic=${service.slug}#consultation` : cta.href;
const steps = service?.process ?? [
  { title: 'Consultation & site visit', text: 'Tell us what you need. We visit to see the work in person.' },
  { title: 'Scope & proposal', text: 'We define the work and discuss estimate terms for your project.' },
  { title: 'Planning & construction', text: 'We schedule the work and get it done.' },
];
const review = service ? reviewFor(service.slug) : undefined;
const hasMedia = !!heroPhoto || !!service?.graphic;
---
{hub ? (
  <BaseLayout
    title={hub.pageTitle}
    description={hub.description}
    path={hub.path}
    schema={[breadcrumbSchema(crumbs.map((c) => ({ label: c.label, href: c.href ?? hub.path }))), serviceSchema(hub.h1, hub.description, hub.path)]}
  >
    <ServiceHub group={hub} crumbs={crumbs} />
  </BaseLayout>
) : service && (
  <BaseLayout
    title={service.title}
    description={service.description}
    path={service.path}
    schema={[breadcrumbSchema(crumbs.map((c) => ({ label: c.label, href: c.href ?? service.path }))), serviceSchema(service.name, service.description, service.path)]}
  >
    <section class:list={['page-hero', { 'page-hero--split': hasMedia }]}>
      <div class="container">
        <div>
          <Breadcrumbs items={crumbs} />
          <span class="kicker">{service.kicker ?? 'Service'}</span>
          <h1>{service.h1}</h1>
          <p class="lede">{service.intro}</p>
          <div class="actions">
            <a class="btn btn--primary btn--lg" href={consultHref} data-track="cta_consultation">{cta.longLabel}</a>
            <a class="btn btn--outline btn--lg" href={company.phoneHref} data-track="phone_click"><Icon name="phone" />Call or text</a>
          </div>
        </div>
        {heroPhoto && (
          <figure class="photo-figure">
            <div class="ph"><Photo photo={heroPhoto} priority sizes="(max-width: 832px) calc(100vw - 2.5rem), 45vw" widths={[480, 720, 960, 1280]} /></div>
            <figcaption>{heroPhoto.caption}</figcaption>
          </figure>
        )}
        {!heroPhoto && service.graphic && (
          <figure class="photo-figure">
            <div class="graphic-panel"><ArchGraphic kind={service.graphic} /></div>
            <figcaption>Illustration</figcaption>
          </figure>
        )}
      </div>
    </section>

    <section class="section section--white section--tight" aria-labelledby="examples-h">
      <div class:list={['container', supportPhoto ? 'svc-body svc-body--flip' : 'svc-body']}>
        <div>
          <h2 id="examples-h" class="h-lg">Typical projects</h2>
          <p class="muted mt-1" style="max-width:40ch">{service.summary} No job is too small to ask about.</p>
          {review && <div class="mt-2"><ReviewCard review={review} /></div>}
        </div>
        <div>
          <ul class="check-list">
            {service.examples.map((ex) => <li><Icon name="check" />{ex}</li>)}
          </ul>
        </div>
        {supportPhoto && (
          <figure class="photo-figure" style="grid-column:1 / -1">
            <div class="ph"><Photo photo={supportPhoto} sizes="(max-width: 1460px) calc(100vw - 9rem), 1320px" widths={[640, 960, 1280, 1600, 2000]} /></div>
            <figcaption>{supportPhoto.caption}</figcaption>
          </figure>
        )}
      </div>
    </section>

    <section class="section section--paper section--tight" aria-labelledby="process-h">
      <div class="container">
        <div class="section-head">
          <span class="kicker">How it works</span>
          <h2 id="process-h" class="h-lg">From first call to finished work</h2>
        </div>
        <ProcessSteps steps={steps} />
        <p class="process-note muted">Ask us about financing through {financing.provider}.</p>
      </div>
    </section>

    {related.length > 0 && (
      <section class="section section--white section--tight" aria-labelledby="related-h">
        <div class="container">
          <h2 id="related-h" class="h-md" style="margin-bottom:1rem">Related services</h2>
          <ul class="chips">
            {related.map((r) => <li><a href={serviceHref(r)}>{r.name}</a></li>)}
            <li><a class="chips__all" href="/services">All services<Icon name="arrow" /></a></li>
          </ul>
        </div>
      </section>
    )}

    <ConsultCallout service={service.formService} topic={service.slug} />
  </BaseLayout>
)}
