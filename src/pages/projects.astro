---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import ConsultCallout from '../components/ConsultCallout.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { photos } from '../data/photos';
import { reviews } from '../data/reviews';
import { galleryPhotos } from '../data/photos';
const doug = reviews.find((r) => r.id === 'doug')!;
import { breadcrumbSchema } from '../lib/seo';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Projects' }];
const slug = (c: string) => c.toLowerCase().replace(/\s+/g, '-');
// Only categories that actually have photos.
const categories = [...new Set(galleryPhotos.map((p) => p.category))];
---
<BaseLayout
  title="Projects"
  description="A new home in East Chicago, a garage rebuilt after a fire in Munster, a second-floor addition, kitchens, bathrooms and more by Solutions and Improvements in Northwest Indiana and South Chicagoland."
  path="/projects"
  schema={[breadcrumbSchema(crumbs.map((c) => ({ label: c.label, href: c.href ?? '/projects' })))]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="kicker">Projects</span>
      <h1>Our work</h1>
      <p class="lede">Real jobs from Northwest Indiana. Three stories first, then photos from recent projects and work in progress.</p>
    </div>
  </section>

  <section class="section section--white section--tight" aria-labelledby="stories-h">
    <div class="container">
      <h2 id="stories-h" class="visually-hidden">Project stories</h2>
      <article class="story">
        <BeforeAfter before={photos.GB} after={photos.GA} label="Compare the Munster garage before and after the rebuild" caption="Before and after · Munster, IN" priority />
        <div>
          <h3>Garage rebuilt after a fire</h3>
          <p>A garage in Munster was lost to fire. We cleared what was left and rebuilt it with new framing, siding, an overhead door and a concrete apron.</p>
          <div class="mt-1"><ReviewCard review={doug} /></div>
          <a class="link-arrow" href="/repairs-and-restoration">Repairs and restoration<Icon name="arrow" /></a>
        </div>
      </article>
      <article class="story">
        <figure style="margin:0"><div class="ph"><Photo photo={photos.ADD} sizes="(max-width: 832px) calc(100vw - 2.5rem), 55vw" widths={[480, 720, 960, 1280]} /></div></figure>
        <div>
          <h3>A second floor, set by crane</h3>
          <p>To add a full second story, the framing and roof trusses went up with a crane on site. Building up adds a full floor of space without giving up any of the yard.</p>
          <a class="link-arrow" href="/home-additions">Home additions<Icon name="arrow" /></a>
        </div>
      </article>
      <article class="story">
        <figure style="margin:0"><div class="ph"><Photo photo={photos.EC} sizes="(max-width: 832px) calc(100vw - 2.5rem), 55vw" widths={[480, 720, 960, 1280]} /></div></figure>
        <div>
          <h3>A new home in East Chicago</h3>
          <p>This house started as a plan and an empty lot. We built it from scratch: foundation, framing, siding, stone and the covered front porch.</p>
          <a class="link-arrow" href="/newconstruction">New construction<Icon name="arrow" /></a>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--paper section--tight" aria-labelledby="gallery-h" style="padding-top:2.5rem">
    <div class="container" data-gallery>
      <h2 id="gallery-h" class="h-lg" style="margin-bottom:1.5rem">More recent work</h2>
      <div class="filters" role="group" aria-label="Filter photos by category" hidden data-filters>
        <button type="button" aria-pressed="true" data-filter="all">All</button>
        {categories.map((c) => <button type="button" aria-pressed="false" data-filter={slug(c)}>{c}</button>)}
      </div>
      <p class="visually-hidden" role="status" aria-live="polite" data-gallery-status></p>
      <ul class="gallery">
        {galleryPhotos.map((p, i) => (
          <li data-cat={slug(p.category)} data-caption={`${p.caption} · ${p.category}`}>
            <button type="button" data-open={i} aria-label={`Open larger view: ${p.caption}`}>
              <span class="ph"><Photo photo={p} sizes="(max-width: 640px) calc(100vw - 2.5rem), (max-width: 1100px) 46vw, 30vw" widths={[300, 400, 540, 720, 900]} /></span>
              <span class="cap"><small>{p.category}</small>{p.caption}</span>
            </button>
            <template data-full={i}>
              <Photo photo={p} sizes="92vw" widths={[960, 1280, 1600, 2000]} />
            </template>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
    <figure>
      <div data-lb-media></div>
      <figcaption data-lb-caption></figcaption>
    </figure>
    <div class="lb-bar">
      <button type="button" data-lb-prev aria-label="Previous photo"><Icon name="prev" /></button>
      <span data-lb-count aria-live="polite"></span>
      <button type="button" data-lb-next aria-label="Next photo"><Icon name="next" /></button>
      <button type="button" data-lb-close>Close</button>
    </div>
  </dialog>

  <ConsultCallout />
</BaseLayout>
<script>
  import '../scripts/gallery.ts';
</script>
