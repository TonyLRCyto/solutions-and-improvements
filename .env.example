# Build-time settings (public, non-secret). Copy to .env for local builds or set in Cloudflare build settings.
# Canonical origin used for canonical URLs, Open Graph and the sitemap.
PUBLIC_SITE_URL=https://www.solutionsandimprovements.com
# Solutions-specific Acorn Finance link. Leave empty until Andy supplies it (text-only mention is shown).
PUBLIC_ACORN_URL=
# Cloudflare Turnstile site key (optional). If set, TURNSTILE_SECRET_KEY must also be set or the form fails closed.
PUBLIC_TURNSTILE_SITE_KEY=

# SITE_MODE is not set here: it comes from wrangler.jsonc vars.
#   npm run build             -> preview (noindex, empty sitemap, robots Disallow, draft city pages built)
#   npm run build:production  -> production (CLOUDFLARE_ENV=production)
